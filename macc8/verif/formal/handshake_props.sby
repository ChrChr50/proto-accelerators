# k-induction proof of the activation handshake properties in macc8_props_rx.sv.
# From verif/formal/:  sby -f handshake_props.sby
[options]
mode prove
depth 12

[engines]
smtbmc z3

[script]
read -formal macc8_pkg.sv macc8_serial_rx.sv macc8_props_rx.sv
prep -top macc8_props_rx

[files]
../../rtl/macc8_pkg.sv
../../rtl/macc8_serial_rx.sv
macc8_props_rx.sv
