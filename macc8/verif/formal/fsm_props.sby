# k-induction proof of the FSM properties in macc8_props_fsm.sv.
# From verif/formal/:  sby -f fsm_props.sby
[options]
mode prove
depth 12

[engines]
smtbmc z3

[script]
# one read call for all three, so macc8_pkg:: resolves in plain Yosys
read -formal macc8_pkg.sv macc8_fsm.sv macc8_props_fsm.sv
prep -top macc8_props_fsm

[files]
../../rtl/macc8_pkg.sv
../../rtl/macc8_fsm.sv
macc8_props_fsm.sv
