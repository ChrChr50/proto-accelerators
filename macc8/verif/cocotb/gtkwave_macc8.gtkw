[*]
[*] MACC-8 wave layout. Usage: make WAVES=1, then gtkwave macc8.fst gtkwave_macc8.gtkw
[*] Paths are under Verilator's TOP.macc8_top wrapper; with another simulator
[*] you may have to drag the signals in by hand.
[*]
[dumpfile] "macc8.fst"
[savefile] "gtkwave_macc8.gtkw"
[timestart] 0
[size] 1600 900
@28
TOP.macc8_top.clk
TOP.macc8_top.rst_n
@200
-serial
@28
TOP.macc8_top.act_valid
TOP.macc8_top.act_ready
@22
TOP.macc8_top.act_data[7:0]
@200
-regbus
@28
TOP.macc8_top.reg_write
@22
TOP.macc8_top.reg_addr[7:0]
TOP.macc8_top.reg_wdata[31:0]
TOP.macc8_top.reg_rdata[31:0]
@200
-status
@28
TOP.macc8_top.busy
TOP.macc8_top.done
@22
TOP.macc8_top.u_datapath.acc_q[31:0]
@28
TOP.macc8_top.u_datapath.ovf_q
@200
-fsm
@22
TOP.macc8_top.u_fsm.cur_state[1:0]
[pattern_trace] 1
[pattern_trace] 0
